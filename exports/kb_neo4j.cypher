// diabetes_mas KB export v1
MATCH (n) WHERE any(l IN labels(n) WHERE l IN ["Recommendation", "Source", "Topic", "Food", "FoodCategory", "Drug", "Condition", "Disease", "Symptom", "RiskFactor", "Measurement", "Patient"]) DETACH DELETE n;
CREATE (:`Recommendation` {`_kid`: 0, `seq`: 0, `text`: "Người tiểu đường nên khám mắt hàng năm để phát hiện bệnh võng mạc tiểu đường. Cần kiểm soát huyết áp và cholesterol.", `title`: "Tầm soát biến chứng mắt"});
CREATE (:`Recommendation` {`_kid`: 1, `seq`: 1, `text`: "Giai đoạn đầu của biến chứng thận thường rất mờ nhạt, phần lớn chỉ phát hiện qua xét nghiệm nước tiểu tìm vi đạm niệu hoặc siêu âm bụng.", `title`: "Tầm soát biến chứng thận"});
CREATE (:`Recommendation` {`_kid`: 2, `seq`: 2, `text`: "Biến chứng thần kinh làm giảm nhận biết chấn thương bàn chân, như do giày không vừa, có thể dẫn đến loét và nhiễm trùng. Cần chăm sóc chân thường xuyên.", `title`: "Chăm sóc bàn chân"});
CREATE (:`Recommendation` {`_kid`: 3, `seq`: 3, `text`: "Với bệnh thận do đái tháo đường, mục tiêu gồm huyết áp dưới 140/80 mmHg và HbA1c dưới 7% để làm chậm tiến triển đạm niệu, kèm điều trị mỡ máu.", `title`: "Kiểm soát huyết áp và đường huyết khi có bệnh thận"});
CREATE (:`Recommendation` {`_kid`: 4, `seq`: 4, `text`: "Người tiểu đường có thể chọn đi bộ, yoga, bơi lội, pilates. Với đi bộ nhanh, nên tập khoảng 30 phút mỗi ngày, liên tục 5 ngày trong tuần.", `title`: "Mức vận động khuyến nghị"});
CREATE (:`Recommendation` {`_kid`: 5, `seq`: 5, `text`: "Kiểm tra đường huyết trước, trong và sau khi tập; không tập khi đường huyết cao hơn 240. Nếu đường huyết dưới 100-120 hãy ăn một quả táo hoặc uống ly sữa trước khi tập và mang theo bữa ăn nhẹ.", `title`: "An toàn đường huyết khi vận động"});
CREATE (:`Recommendation` {`_kid`: 6, `seq`: 6, `text`: "Tập trong vòng một hoặc hai giờ sau bữa ăn có thể làm đường huyết giảm tự nhiên. Nên kiểm tra đường huyết trước, trong và sau khi tập.", `title`: "Tập luyện sau bữa ăn"});
CREATE (:`Recommendation` {`_kid`: 7, `seq`: 7, `text`: "Nên ưu tiên các bài tập không dồn áp lực lên bàn chân như tập ở tư thế ngồi, nằm trên sàn hoặc bơi lội.", `title`: "Vận động khi có vấn đề bàn chân"});
CREATE (:`Recommendation` {`_kid`: 8, `seq`: 8, `text`: "Đường huyết trên 250-300 mg/dL là mức báo động, người bệnh có thể mệt mỏi, khát nước, tiểu nhiều, mắt mờ. Khi đường huyết quá cao cần liên hệ ngay bác sĩ hoặc đến cơ sở y tế gần nhất.", `title`: "Xử trí tăng đường huyết"});
CREATE (:`Recommendation` {`_kid`: 9, `seq`: 9, `text`: "Nhiễm toan ceton là tình trạng cấp cứu khi thiếu insulin khiến gan phân hủy chất béo thành ceton. Dấu hiệu gồm buồn nôn, nôn hoặc đau bụng.", `title`: "Nhiễm toan ceton khi đường huyết cao"});
CREATE (:`Recommendation` {`_kid`: 10, `seq`: 10, `text`: "Nhiễm toan ceton có đường huyết trên 250 mg/dL kèm lơ mơ hoặc hôn mê, buồn nôn, nôn, đau bụng, thở nhanh sâu và hơi thở mùi táo thối.", `title`: "Dấu hiệu cấp cứu của tăng đường huyết"});
CREATE (:`Recommendation` {`_kid`: 11, `seq`: 11, `text`: "Tăng áp lực thẩm thấu là biến chứng của tiểu đường tuýp 2 với đường huyết rất cao, trên 600 mg/dL. Tình trạng này ít gặp hơn nhiễm toan ceton nhưng nguy hiểm hơn.", `title`: "Tăng áp lực thẩm thấu"});
CREATE (:`Recommendation` {`_kid`: 12, `seq`: 12, `text`: "HbA1c (A1c) từ 5,7 đến 6,4 phần trăm được chẩn đoán tiền tiểu đường và nên xét nghiệm nhắc lại để xác nhận. Xét nghiệm đường huyết lúc đói cần nhịn ăn tám giờ hoặc qua đêm.", `title`: "Tiêu chuẩn chẩn đoán tiền đái tháo đường"});
CREATE (:`Recommendation` {`_kid`: 13, `seq`: 13, `text`: "Mục tiêu tham khảo: đường huyết đói 70-130 mg/dl, sau ăn 1-2 giờ dưới 180 mg/dl, lúc đi ngủ 110-150 mg/dl. HbA1c dưới 6,5% và xét nghiệm 2-4 lần mỗi năm.", `title`: "Mục tiêu đường huyết"});
CREATE (:`Recommendation` {`_kid`: 14, `seq`: 14, `text`: "Hạ đường huyết là biến chứng hay gặp ở người đái tháo đường và là tình trạng cấp cứu nội khoa. Xét nghiệm đường huyết dưới 3,9 mmol/l (70 mg/dl) giúp xác định chẩn đoán.", `title`: "Ngưỡng hạ đường huyết"});
CREATE (:`Recommendation` {`_kid`: 15, `seq`: 15, `text`: "Khi có triệu chứng, ăn hoặc uống 15-20 gam carbohydrate tác dụng nhanh và kiểm tra đường huyết sau 15 phút. Nếu vẫn dưới 70 mg/dL (3,9 mmol/L) thì bổ sung thêm 15-20 gam và lặp lại các bước này.", `title`: "Xử trí hạ đường huyết theo quy tắc 15-15"});
CREATE (:`Recommendation` {`_kid`: 16, `seq`: 16, `text`: "Hạ đường huyết nghiêm trọng kèm co giật, mất ý thức hoặc hôn mê cần ngay lập tức đưa người bệnh đến cơ sở y tế gần nhất hoặc gọi cấp cứu, đừng cố cho người bệnh ăn uống. Không xử trí kịp thời có thể nguy hiểm đến tính mạng.", `title`: "Xử trí khi hạ đường huyết nặng"});
CREATE (:`Recommendation` {`_kid`: 17, `seq`: 17, `text`: "Dấu hiệu có thể gồm chóng mặt, lo âu, đau đầu, da xanh tái, vã mồ hôi, hồi hộp, đánh trống ngực và nhịp tim nhanh. Tình trạng này có thể diễn biến nhanh dẫn đến hôn mê nên cần nhận biết sớm.", `title`: "Triệu chứng hạ đường huyết"});
CREATE (:`Recommendation` {`_kid`: 18, `seq`: 18, `text`: "Uống nhiều rượu mà không ăn có thể ngăn gan giải phóng glucose dự trữ vào máu và gây hạ đường huyết.", `title`: "Rượu bia và hạ đường huyết"});
CREATE (:`Recommendation` {`_kid`: 19, `seq`: 19, `text`: "Ăn quá ít trong thời gian dài hoặc ăn kiêng giảm cân có thể góp phần gây hạ đường huyết. Đây cũng là tác dụng phụ của thuốc điều trị tiểu đường.", `title`: "Ăn kiêng và hạ đường huyết"});
CREATE (:`Recommendation` {`_kid`: 20, `seq`: 20, `text`: "Thời gian từ lúc tiêm đến lúc ăn tuỳ loại insulin, với loại bán chậm (lente, NPH, insulatard) là 60 phút. Ăn muộn hơn thời gian này thì nguy cơ hạ đường huyết rất cao.", `title`: "An toàn khi dùng insulin"});
CREATE (:`Recommendation` {`_kid`: 21, `seq`: 21, `text`: "Sát khuẩn vị trí tiêm và giữ da sạch. Bụng là vị trí hay được chọn, mũi tiêm nên cách rốn khoảng 5cm. Đổi vị trí tiêm liên tục để tránh loạn dưỡng tại vùng tiêm.", `title`: "Kỹ thuật tiêm insulin"});
CREATE (:`Recommendation` {`_kid`: 22, `seq`: 22, `text`: "Tiêm insulin thuộc nhóm có nguy cơ hạ đường huyết cao, cùng với sulfonylurea và glinide. Khi dùng cần theo dõi đường huyết và trao đổi với bác sĩ.", `title`: "Nhóm thuốc phối hợp với insulin"});
CREATE (:`Recommendation` {`_kid`: 23, `seq`: 23, `text`: "Cần đánh giá chức năng thận trước khi dùng metformin. eGFR dưới 30 mL/phút/1,73 m2 thì không nên dùng; eGFR 60-89 có thể xem xét giảm liều. Thuốc có thể làm giảm vitamin B12.", `title`: "Metformin và chức năng thận"});
CREATE (:`Recommendation` {`_kid`: 24, `seq`: 24, `text`: "Nhóm có nguy cơ hạ đường huyết cao gồm sulfonylurea (như gliclazide), glinide và insulin.", `title`: "Sulfonylurea và nguy cơ hạ đường huyết"});
CREATE (:`Recommendation` {`_kid`: 25, `seq`: 25, `text`: "Pioglitazone có thể gây giữ nước và tăng cân ở người suy tim. Các thuốc ức chế DPP-4 như sitagliptin, linagliptin dường như cũng có thể làm người suy tim rơi vào tình trạng nguy hiểm, cần bác sĩ theo dõi.", `title`: "Thuốc khi có suy tim"});
CREATE (:`Recommendation` {`_kid`: 26, `seq`: 26, `text`: "Thuốc đồng vận GLP-1 có thể gây buồn nôn, nôn, viêm tụy cấp. Không dùng khi có tiền sử gia đình mắc ung thư giáp dạng tủy hoặc đa u tuyến nội tiết loại 2.", `title`: "Thuốc GLP-1 và lưu ý"});
CREATE (:`Recommendation` {`_kid`: 27, `seq`: 27, `text`: "Nên ưu tiên ngũ cốc nguyên hạt, đậu đỗ, cá, thịt nạc, thịt gia cầm bỏ da và ăn nhiều rau. Chế biến bằng cách hấp, luộc, nướng, hạn chế rán và xào.", `title`: "Nguyên tắc dinh dưỡng"});
CREATE (:`Recommendation` {`_kid`: 28, `seq`: 28, `text`: "Không nên cắt bỏ hoàn toàn tinh bột mà chọn nguồn có chỉ số đường huyết thấp như yến mạch, gạo lứt, bánh mì nguyên cám và các loại đậu.", `title`: "Chọn tinh bột và chỉ số đường huyết"});
CREATE (:`Recommendation` {`_kid`: 29, `seq`: 29, `text`: "GI thấp là dưới 55%, rất thấp là dưới 40%. Nên phối hợp thực phẩm GI cao với thực phẩm GI thấp và ăn rau trước khi ăn cơm.", `title`: "Chỉ số đường huyết của thực phẩm"});
CREATE (:`Recommendation` {`_kid`: 30, `seq`: 30, `text`: "Nên ăn nhạt, mỗi ngày không quá 6 g muối và hạn chế món mặn như mắm, dưa muối.", `title`: "Hạn chế muối"});
CREATE (:`Recommendation` {`_kid`: 31, `seq`: 31, `text`: "Nên hạn chế hoa quả nhiều đường như nho, xoài, anh đào, sầu riêng.", `title`: "Hạn chế trái cây nhiều đường"});
CREATE (:`Recommendation` {`_kid`: 32, `seq`: 32, `text`: "Người bị tiểu đường được khuyến cáo nạp khoảng 45-60% lượng calo từ carb mỗi ngày. Lượng carb cao thường đòi hỏi insulin liều cao hoặc thêm thuốc để kiểm soát đường huyết.", `title`: "Lượng carbohydrate mỗi ngày"});
CREATE (:`Recommendation` {`_kid`: 33, `seq`: 33, `text`: "Có thể chia đĩa ăn làm 4 phần: 1/4 tinh bột như yến mạch, gạo lứt và 2/4 rau củ. Chế độ ăn nên giàu chất xơ để hạn chế tăng glucose sau bữa ăn.", `title`: "Chia đĩa ăn và chất xơ"});
CREATE (:`Recommendation` {`_kid`: 34, `seq`: 34, `text`: "Để phòng tránh tiểu đường nên ăn lành mạnh, luyện tập thường xuyên và giảm cân nếu BMI từ 23 kg/m2 trở lên.", `title`: "Giảm cân khi thừa cân"});
CREATE (:`Recommendation` {`_kid`: 35, `seq`: 35, `text`: "Tiêu chuẩn chẩn đoán đái tháo đường dựa vào 1 trong 4 tiêu chí sau đây: a) Glucose huyết tương lúc đói ≥ 126 mg/dL (hay 7 mmol/L) hoặc: b) Glucose huyết tương ở thời điểm sau 2 giờ làm nghiệm pháp dung nạp với 75g glucose bằng đường uống ≥ 200 mg/dL (hay 11,1 mmol/L) c) HbA1c ≥ 6,5% (48 mmol/mol). Xét nghiệm HbA1c phải được thực hiện bằng phương pháp đã chuẩn hóa theo tiêu chuẩn quốc tế. d) người bệnh có triệu chứng kinh điển của tăng glucose huyết hoặc của cơn tăng glucose huyết cấp kèm mức glucose huyết tương bất kỳ ≥ 200 mg/dL (hay 11,1 mmol/L). Chẩn đoán xác định nếu có 2 kết quả trên ngưỡng chẩn đoán trong cùng 1 mẫu máu xét nghiệm hoặc ở 2 thời điểm khác nhau đối với tiêu chí a, b, hoặc c; riêng tiêu chí d: chỉ cần một lần xét nghiệm duy nhất.", `title`: "Tiêu chuẩn chẩn đoán đái tháo đường"});
CREATE (:`Recommendation` {`_kid`: 36, `seq`: 36, `text`: "Bảng 4: Mục tiêu điều trị cho người bệnh đái tháo đường ở người trưởng thành, không có thai Mục tiêu Chỉ số HbA1c < 7% (53mmol/mol) Glucose huyết tương mao mạch lúc đói, trước ăn 80-130 mg/dL (4,4-7,2 mmol/L)* Đỉnh glucose huyết tương mao mạch sau ăn 1-2 giờ <180 mg/dL (10,0 mmol/L)*", `title`: "Mục tiêu điều trị ở người trưởng thành không mang thai"});
CREATE (:`Recommendation` {`_kid`: 37, `seq`: 37, `text`: "Mục tiêu có thể thấp hơn (HbA1c <6,5%) ở người bệnh trẻ, mới chẩn đoán, không có các bệnh lý tim mạch, nguy cơ hạ glucose máu thấp. - Ngược lại, mục tiêu có thể cao hơn (HbA1c từ 7,5 – 8%) ở những người bệnh lớn tuổi, mắc bệnh đái tháo đường đã lâu, có nhiều bệnh lý đi kèm, có tiền sử hạ glucose máu nặng trước đó.", `title`: "Cá nhân hoá mục tiêu HbA1c"});
CREATE (:`Recommendation` {`_kid`: 38, `seq`: 38, `text`: "Trước khi bắt đầu chương trình luyện tập thể lực, người bệnh đái tháo đường nên được kiểm tra các biến chứng có thể ảnh hưởng bởi vận động thể lực cường độ cao: bệnh mạch vành, bệnh võng mạc, bệnh thần kinh ngoại biên và biến chứng bàn chân đái tháo đường. Không tập thể dục nếu glucose huyết >14,0 hoặc <5,5 mmol/L, hoặc cảm thấy đói, mệt.", `title`: "Kiểm tra trước khi tập thể dục"});
CREATE (:`Recommendation` {`_kid`: 39, `seq`: 39, `text`: "Trên đái tháo đường típ 1 có đường huyết cao do ngưng insulin và có ceton, thể dục có thể làm đường huyết tăng thêm. Không nên thể dục trong trường hợp này cho tới khi dùng đủ insulin và hết ceton. - người bệnh đái tháo đường típ 2 nếu thấy khoẻ và không có ceton, vẫn có thể thể dục và cần uống nước đầy đủ.", `title`: "Thể dục khi đường huyết cao và có ceton"});
CREATE (:`Recommendation` {`_kid`: 40, `seq`: 40, `text`: "Nên tập thể dục 5 ngày mỗi tuần, tốt nhất là thể dục hết các ngày trong tuần. - Loại hình luyện tập thông dụng và dễ áp dụng nhất: đi bộ tổng cộng 150 phút mỗi tuần (hoặc 30 phút mỗi ngày), không nên ngưng luyện tập 2 ngày liên tiếp. Mỗi tuần nên tập kháng lực 2-3 lần (kéo dây thun, nâng tạ). - Có thể thay thế bằng cách chia nhỏ thời gian tập thể dục trong ngày. Ví dụ: đi bộ sau 3 bữa ăn, mỗi lần 10-15 phút. - Những hoạt động tăng tiêu thụ năng lượng hàng ngày có lợi cho kiểm soát đái tháo đường: làm vườn, đi bộ lên cầu thang, lau nhà,… - Tránh ngồi kéo dài và mỗi 20 tới 30 phút nên đứng dậy đi lại.", `title`: "Lượng vận động khuyến cáo mỗi tuần"});
CREATE (:`Recommendation` {`_kid`: 41, `seq`: 41, `text`: "Người thừa cân, béo phì cần giảm cân, mục tiêu giảm 5-10% trọng lượng cơ thể trong vòng 3-6 tháng. Do vậy mức năng lượng khẩu phần ăn cũng giảm dần, 250-500 kcal/ngày (giảm từng giai đoạn, không giảm đột ngột)", `title`: "Giảm cân ở người thừa cân, béo phì"});
CREATE (:`Recommendation` {`_kid`: 42, `seq`: 42, `text`: "Lượng Glucid ăn vào nên chiếm 50 – 60% tổng số năng lượng. + Tối thiểu: 130g Glucid/ngày. - Khuyến cáo lựa chọn thực phẩm: + Bữa ăn nên sử dụng các thực phẩm chứa nhiều chất xơ như rau, đậu, các loại ngũ cốc nguyên hạt như gạo lứt/gạo lật, khoai củ, bánh mỳ đen, hoa quả. + Nên hạn chế các thức ăn chứa nhiều đường như bánh kẹo, mứt sấy khô, mật ong, hoa quả ngọt như mít, đu đủ, xoài, …", `title`: "Chọn chất bột đường"});
CREATE (:`Recommendation` {`_kid`: 43, `seq`: 43, `text`: "Ăn trái cây nên ăn nguyên múi, nguyên miếng không nên ăn nước ép trái cây vì quá trình chế biến đã bị mất chất xơ nên đường bị hấp thu nhanh hơn. + Không nên ăn hoa quả quá 20% mức năng lượng hàng ngày, vì quá mức sẽ gây ảnh hưởng không tốt đến chuyển hóa chất béo, chất bột đường. + Chọn những trái cây có chỉ số đường huyết thấp: ổi, lê, táo, cam. + Ăn vừa phải trái cây có đường huyết trung bình: chuối, đu đủ. + Hạn chế trái cây có chỉ số tăng đường huyết nhanh: dưa hấu, vải, nhãn, xoài", `title`: "Chọn trái cây"});
CREATE (:`Recommendation` {`_kid`: 44, `seq`: 44, `text`: "Nên ăn nhạt tương đối, < 5g muối/ngày (2,000 mg Na/ngày) - Hạn chế các thực phẩm chế biến sẵn chứa nhiều muối: dưa muối, cà muối, mỳ tôm, xúc xích, ... - Hạn chế cho thêm nước mắm, gia vị khi ăn uống. - người bệnh có tăng huyết áp và suy thận nên hỏi ý kiến bác sĩ hoặc chuyên gia dinh dưỡng.", `title`: "Lượng muối theo Bộ Y tế"});
CREATE (:`Recommendation` {`_kid`: 45, `seq`: 45, `text`: "Chất xơ có tác dụng giúp thức ăn ở dạ dày lâu hơn, ngăn cản men tiêu hóa tác dụng với thức ăn => chậm tốc độ tiêu hóa, giải phóng Glucose vào máu từ từ. Ngoài ra, chất xơ còn có tác dụng giảm hấp thu Cholesterol, chống xơ vữa động mạch, điều hòa nhu động ruột, tác dụng hữu ích trong giảm táo bón và hạn chế các tác nhân ung thư trực tràng và đường ruột, …. - Chất xơ có nhiều trong các phần như vỏ, dây, lá, hạt, … của các loại cây lấy quả, rau xanh và ngũ cốc. - Nhu cầu: 20 – 30g/ngày.", `title`: "Chất xơ"});
CREATE (:`Recommendation` {`_kid`: 46, `seq`: 46, `text`: "Điều trị cơn hạ đường huyết cho người bệnh tỉnh táo, tự uống được (Glucose huyết <3,9 mmol/L hay 70mg/dL) bằng 15-20g glucose pha nước uống, hoặc bất cứ loại thực phẩm nào chứa carbohydrate có glucose dùng thay thế. Thử lại glucose huyết mao mạch sau 15 phút. Nếu vẫn còn thấp, điều trị nhắc lại liều như trên. Nếu glucose huyết về bình thường: cho người bệnh ăn nhẹ ngay để tránh nguy cơ tái xuất hiện hạ glucose huyết.", `title`: "Điều trị cơn hạ đường huyết khi còn tỉnh táo"});
CREATE (:`Recommendation` {`_kid`: 47, `seq`: 47, `text`: "Hạ đường huyết được chia làm 3 mức độ, dựa vào nồng độ glucose huyết: Bảng Phân mức độ hạ glucose huyết Tiêu chí glucose huyết Mức 1 Glucose <70 mg/dL (3,9 mmol/L) và ≥54 mg/dL (3,0 mmol/L) Mức 2 Glucose <54 mg/dL (3,0 mmol/L) Mức 3 Hạ đường huyết mức độ nặng, người bệnh có rối loạn ý thức và/hoặc có thay đổi biểu hiện toàn thân cần xử trí cấp cứu", `title`: "Phân mức độ hạ đường huyết"});
CREATE (:`Recommendation` {`_kid`: 48, `seq`: 48, `text`: "Cần chỉ dẫn cho người bệnh cách phát hiện các triệu chứng sớm của hạ glucose máu: đói, bồn chồn, hoa mắt, vã mồ hôi, tay chân lạnh. Khi glucose huyết xuống đến khoảng 54 mg/dL (3 mmol/L) người bệnh thường có các triệu chứng cường giao cảm (tim đập nhanh, hồi hộp, đổ mồ hôi, lạnh run) và đối giao cảm (buồn nôn, đói). Nếu các triệu chứng này không được nhận biết và xử trí kịp thời, glucose huyết giảm xuống dưới 50 mg/dL (2,8 mmol/L) sẽ xuất hiện các triệu chứng thần kinh như bứt rứt, lú lẫn, nhìn mờ, mệt mỏi, nhức đầu, nói khó. Glucose huyết giảm hơn nữa có thể dẫn đến hôn mê, co giật.", `title`: "Nhận biết sớm hạ đường huyết khi tiêm insulin"});
CREATE (:`Recommendation` {`_kid`: 49, `seq`: 49, `text`: "Tốt nhất để ở 2-8°C sẽ giữ được tới khi hết hạn sử dụng. Nếu không có tủ lạnh có thể để ở nhiệt phòng <30°C cho phép giữ được 1 tháng mà không giảm tác dụng đối với các loại insulin sản xuất bằng phương pháp tái tổ hợp DNA. Nếu insulin để ở nhiệt độ > 30°C sẽ giảm tác dụng. Luôn cố gắng giữ insulin trong môi trường thoáng mát, không tiếp xúc trực tiếp với ánh sáng mặt trời. Nếu dùng đá lạnh cần chú ý không được làm đông lạnh insulin. Không được để trong ngăn đá làm hỏng insulin.", `title`: "Bảo quản insulin"});
CREATE (:`Recommendation` {`_kid`: 50, `seq`: 50, `text`: "Một lọ insulin có 10 mL, với các nồng độ khác nhau. Hiện trên thị trường có 2 loại là 40 IU/mL (U 40-một lọ 10 mL có 400 đơn vị) và 100 IU/mL (U100- một lọ 10 mL có 1000 đơn vị). Chú ý phải dùng loại ống tiêm phù hợp với nồng độ thuốc: insulin loại U 40 phải dùng ống tiêm insulin 1mL = 40 IU, insulin U100 phải dùng ống tiêm 1mL=100IU.", `title`: "Dùng ống tiêm đúng nồng độ insulin"});
CREATE (:`Recommendation` {`_kid`: 51, `seq`: 51, `text`: "Người bệnh đái tháo đường típ 2 cần được khám mắt toàn diện, đo thị lực tại thời điểm được chẩn đoán bệnh đái tháo đường. e) Nếu không có bằng chứng về bệnh võng mạc ở một hoặc nhiều lần khám mắt hàng năm và đường huyết được kiểm soát tốt, có thể xem xét khám mắt 2 năm một lần. Nếu bệnh võng mạc đang tiến triển hoặc đe dọa đến thị lực, phải khám mắt thường xuyên hơn.", `title`: "Lịch khám mắt"});
CREATE (:`Recommendation` {`_kid`: 52, `seq`: 52, `text`: "Thực hiện đánh giá bàn chân toàn diện ít nhất mỗi năm một lần để xác định các yếu tố nguy cơ của loét và cắt cụt chi. e) Tất cả các người bệnh đái tháo đường phải được kiểm tra bàn chân vào mỗi lần khám bệnh.", `title`: "Khám bàn chân định kỳ"});
CREATE (:`Recommendation` {`_kid`: 53, `seq`: 53, `text`: "HbA1c < 6% Đường huyết đói < 95 mg/dL (5,3 mmol/L), VÀ Đường huyết sau ăn - Đường huyết sau ăn 01 giờ < 140 mg/dL (7,8 mmol/L), HOẶC - Đường huyết sau ăn 02 giờ < 120 mg/dL (6,7 mmol/L)", `title`: "Mục tiêu đường huyết trong thai kỳ"});
CREATE (:`Recommendation` {`_kid`: 54, `seq`: 54, `text`: "Các người bệnh đái tháo đường típ 1 nên được đo đường huyết ít nhất 4 lần/ ngày, vào trước các bữa ăn và lúc đi ngủ. - Những người bệnh đái tháo đường típ 2 điều trị bằng các thuốc không phải là insulin hay sulfonylurea: Chỉ cần đo 2 – 3 lần mỗi tuần vào bữa ăn hoặc lúc đi ngủ để đánh giá hiệu quả của điều trị và thay đổi lối sống. - Những người bệnh đái tháo đường típ 2 đang điều trị bằng các thuốc có thể gây hạ đường huyết (insulin, sulfonylurea): - Đang điều trị insulin tích cực, nhiều mũi: Đo 4 lần/ngày, trước 3 bữa ăn và lúc đi ngủ - Điều trị insulin thông thường, tiêm 2 – 3 mũi/ngày: đo 3 lần/ngày vào trước 3 bữa ăn. Đo thêm 1-2 lần/ tuần vào lúc đi ngủ", `title`: "Tự đo đường huyết tại nhà ở người bệnh ngoại trú"});
CREATE (:`Recommendation` {`_kid`: 55, `seq`: 55, `text`: "Thai phụ nên ăn đủ đạm, bột đường, chất béo và chất xơ (20-35 g mỗi ngày), tập thể dục thường xuyên và khám thai định kỳ theo lịch để bác sĩ theo dõi.", `title`: "Đái tháo đường thai kỳ và mang thai"});
CREATE (:`Recommendation` {`_kid`: 56, `seq`: 56, `text`: "Người cao tuổi có mục tiêu đường huyết nới lỏng hơn: 5,6 đến 8,3 mmol/l lúc đói và dưới 11,1 mmol/l sau bữa ăn.", `title`: "Người cao tuổi"});
CREATE (:`Recommendation` {`_kid`: 57, `seq`: 57, `text`: "Mục tiêu vận động cho trẻ em là ít nhất một giờ tập thể dục mỗi ngày; người lớn ít nhất 150 phút mỗi tuần. Nên hỏi bác sĩ trước khi chọn môn tập.", `title`: "Trẻ em và thanh thiếu niên"});
