# Chép thành .env rồi đổi mật khẩu (ít nhất 8 ký tự). Không commit file .env.
NEO4J_PASSWORD=doi-mat-khau-nay
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
# auto: dùng Neo4j nếu được, không thì KB trong bộ nhớ. neo4j: bắt buộc Neo4j. memory: không dùng Neo4j.
KB_BACKEND=auto
# RAG: bộ truy xuất bm25 (mặc định) | vector | hybrid
RAG_RETRIEVER=bm25
# Bước sinh câu trả lời bằng LLM (bỏ trống để tắt). Ollama chạy trên máy: dữ liệu không rời máy.
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY=
# Embedding từ mô hình ngôn ngữ cho bộ truy xuất vector (bỏ trống để dùng LSA offline)
# EMBED_BASE_URL=http://127.0.0.1:11434/v1
# EMBED_MODEL=nomic-embed-text
